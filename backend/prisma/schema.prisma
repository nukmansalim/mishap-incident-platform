// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(uuid())
  name         String?
  email        String  @unique
  passwordHash String? @map("password_hash")

  githubId  String? @unique @map("github_id")
  avatarUrl String? @map("avatar_url")

  status UserStatus @default(active)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizationMembers OrganizationMember[]
  teamMembers         TeamMember[]
  invitations         Invitation[]
  sentInvitations     Invitation[]         @relation("SentInvitations")
  createdClients      Client[]
  escalationSteps     EscalationStep[]
  incidentAlerts      IncidentAlert[]

  @@map("users")
}

model Organization {
  id   String @id @default(uuid())
  name String

  status OrganizationStatus @default(active)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members            OrganizationMember[]
  teams              Team[]
  invitations        Invitation[]
  clients            Client[]
  monitoredServices  MonitoredService[]
  monitors           Monitor[]
  escalationPolicies EscalationPolicy[]

  @@map("organizations")
}

model OrganizationMember {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  userId         String @map("user_id")

  role OrganizationRole @default(member)

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Invitation {
  id             String           @id @default(uuid())
  email          String
  organizationId String
  invitedById    String
  token          String           @unique
  status         InviteStatus     @default(PENDING)
  role           OrganizationRole

  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("SentInvitations", fields: [invitedById], references: [id])
  user         User?        @relation(fields: [userId], references: [id])
  userId       String?

  @@unique([email, organizationId])
  @@index([email])
  @@index([organizationId])
  @@index([status])
}

model Team {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")

  name        String
  description String?
  status      TeamStatus @default(active)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamMember[]

  monitoredServices MonitoredService[]

  @@index([organizationId])
  @@map("teams")
}

model TeamMember {
  id     String @id @default(uuid())
  teamId String @map("team_id")
  userId String @map("user_id")

  role TeamRole @default(viewer)

  createdAt DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model Client {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")

  name        String
  slug        String
  type        ClientType   @default(client)
  status      ClientStatus @default(active)
  description String?

  primaryContactName  String? @map("primary_contact_name")
  primaryContactEmail String? @map("primary_contact_email")
  metadata            Json?

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  services     MonitoredService[]

  @@unique([organizationId, slug])
  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@index([organizationId, type])
  @@map("clients")
}

model MonitoredService {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(120)
  description String? @db.VarChar(500)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  monitors Monitor[]
  clients  Client[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  escalationPolicy EscalationPolicy?

  @@index([organizationId])
  @@index([teamId])
}

model Monitor {
  id              String        @id @default(uuid())
  name            String        @db.VarChar(120)
  type            MonitorType
  endpoint        String        @db.VarChar(255)
  intervalSeconds Int           @default(60)
  status          MonitorStatus @default(PAUSED)

  failureThreshold Int @default(3)
  successThreshold Int @default(3)

  latencyWarningMs       Int?
  latencyCriticalMs      Int?
  latencyBreachThreshold Int  @default(3)

  sslWarningDays  Int?
  sslCriticalDays Int?

  consecutiveFailures        Int @default(0)
  consecutiveSuccesses       Int @default(0)
  consecutiveLatencyBreaches Int @default(0)

  monitoredServiceId String
  monitoredService   MonitoredService @relation(fields: [monitoredServiceId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  incidents        Incident[]
  monitorEvents    MonitorEvent[]
  monitorCheckLogs MonitorCheckLog[]

  @@index([organizationId])
  @@index([monitoredServiceId])
}

model Incident {
  id          String           @id @default(uuid())
  title       String
  description String?
  status      IncidentStatus   @default(OPEN)
  type        IncidentType
  severity    IncidentSeverity

  monitorId       String
  monitor         Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  escalationLevel Int       @default(0) @map("escalation_level")
  lastAlertedAt   DateTime? @map("last_alerted_at")

  openedAt       DateTime  @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  monitorEvents  MonitorEvent[]
  incidentAlerts IncidentAlert[]

  @@index([monitorId, status])
  @@index([type, status])
}

model MonitorEvent {
  id        String  @id @default(uuid())
  monitorId String
  monitor   Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  eventType  MonitorEventType
  fromStatus MonitorStatus?
  toStatus   MonitorStatus?
  message    String?

  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id])

  createdAt DateTime @default(now())

  @@index([monitorId, createdAt])
}

model MonitorCheckLog {
  id        String  @id @default(uuid())
  monitorId String
  monitor   Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  checkedAt     DateTime      @default(now())
  success       Boolean
  derivedStatus MonitorStatus

  latencyMs        Int?
  httpStatus       Int?
  sslDaysRemaining Int?
  errorMessage     String?

  createdAt DateTime @default(now())

  @@index([monitorId, checkedAt])
}

enum EscalationTargetType {
  USER
  TEAM_ROLE
  ORG_ROLE
}

enum AlertDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model EscalationPolicy {
  id                 String  @id @default(uuid())
  organizationId     String  @map("organization_id")
  monitoredServiceId String  @unique @map("monitored_service_id")
  name               String
  isActive           Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  monitoredService MonitoredService @relation(fields: [monitoredServiceId], references: [id], onDelete: Cascade)
  steps            EscalationStep[]

  @@index([organizationId])
  @@map("escalation_policies")
}

model EscalationStep {
  id                 String               @id @default(uuid())
  escalationPolicyId String               @map("escalation_policy_id")
  level              Int
  delayMinutes       Int                  @map("delay_minutes")
  targetType         EscalationTargetType @map("target_type")

  userId           String?           @map("user_id")
  teamRole         TeamRole?         @map("team_role")
  organizationRole OrganizationRole? @map("organization_role")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  escalationPolicy EscalationPolicy @relation(fields: [escalationPolicyId], references: [id], onDelete: Cascade)
  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  incidentAlerts   IncidentAlert[]

  @@unique([escalationPolicyId, level])
  @@index([escalationPolicyId])
  @@index([userId])
  @@map("escalation_steps")
}

model IncidentAlert {
  id               String              @id @default(uuid())
  incidentId       String              @map("incident_id")
  escalationStepId String?             @map("escalation_step_id")
  level            Int
  channel          String
  recipientUserId  String?             @map("recipient_user_id")
  recipientAddress String?             @map("recipient_address")
  deliveryStatus   AlertDeliveryStatus @default(PENDING) @map("delivery_status")
  sentAt           DateTime?           @map("sent_at")
  failureReason    String?             @map("failure_reason")
  createdAt        DateTime            @default(now()) @map("created_at")

  incident       Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  escalationStep EscalationStep? @relation(fields: [escalationStepId], references: [id], onDelete: SetNull)
  recipientUser  User?           @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([incidentId, level])
  @@index([recipientUserId])
  @@map("incident_alerts")
}

enum ClientType {
  client
  project
  department
}

enum ClientStatus {
  active
  inactive
  archived
}

enum UserStatus {
  active
  inactive
  suspended
}

enum OrganizationStatus {
  active
  inactive
}

enum TeamStatus {
  active
  inactive
}

enum OrganizationRole {
  owner
  manager
  member
}

enum TeamRole {
  manager
  responder
  viewer
}

enum MonitorType {
  HTTP
  SSL
  PING
}

enum MonitorStatus {
  UP
  DOWN
  DEGRADED
  PAUSED
  MAINTENANCE
}

enum IncidentStatus {
  OPEN
  ACKED
  RESOLVED
}

enum IncidentType {
  DOWN
  HIGH_LATENCY
  SSL_EXPIRING
  SSL_INVALID
}

enum IncidentSeverity {
  CRITICAL
  HIGH
  WARNING
  INFO
}

enum MonitorEventType {
  STATUS_CHANGE
  INCIDENT_OPENED
  INCIDENT_RESOLVED
}
