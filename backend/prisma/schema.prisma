// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(uuid())
  name         String?
  email        String  @unique
  passwordHash String? @map("password_hash")

  githubId  String? @unique @map("github_id")
  avatarUrl String? @map("avatar_url")

  status UserStatus @default(active)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizationMembers OrganizationMember[]
  teamMembers         TeamMember[]
  invitations         Invitation[]
  sentInvitations     Invitation[]         @relation("SentInvitations")
  createdClients      Client[]

  @@map("users")
}

model Organization {
  id     String             @id @default(uuid())
  name   String
  // slug String @unique
  status OrganizationStatus @default(active)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members           OrganizationMember[]
  teams             Team[]
  invitations       Invitation[]
  clients           Client[]
  monitoredServices MonitoredService[]
  monitors          Monitor[]

  @@map("organizations")
}

model OrganizationMember {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  userId         String @map("user_id")

  role OrganizationRole @default(member)

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Invitation {
  id             String           @id @default(uuid())
  email          String
  organizationId String
  invitedById    String
  token          String           @unique
  status         InviteStatus     @default(PENDING)
  role           OrganizationRole

  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("SentInvitations", fields: [invitedById], references: [id])
  user         User?        @relation(fields: [userId], references: [id])
  userId       String?

  @@unique([email, organizationId])
  @@index([email])
  @@index([organizationId])
  @@index([status])
}

model Team {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")

  name        String
  description String?
  status      TeamStatus @default(active)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamMember[]

  // nanti kalau sudah bikin model Service dan Schedule:
  // services    Service[]
  // schedules   Schedule[]
  monitoredServices MonitoredService[]

  @@index([organizationId])
  @@map("teams")
}

model TeamMember {
  id     String @id @default(uuid())
  teamId String @map("team_id")
  userId String @map("user_id")

  role TeamRole @default(viewer)

  createdAt DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model Client {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")

  name        String
  slug        String
  type        ClientType   @default(client)
  status      ClientStatus @default(active)
  description String?

  primaryContactName  String? @map("primary_contact_name")
  primaryContactEmail String? @map("primary_contact_email")
  metadata            Json?

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  monitor      Monitor?     @relation(fields: [monitorId], references: [id])
  monitorId    String?

  @@unique([organizationId, slug])
  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@index([organizationId, type])
  @@map("clients")
}

model MonitoredService {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(120)
  description String? @db.VarChar(500)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  monitors Monitor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([teamId])
}

model Monitor {
  id              String        @id @default(uuid())
  name            String        @db.VarChar(120)
  type            MonitorType
  endpoint        String        @db.VarChar(255)
  intervalSeconds Int           @default(60)
  status          MonitorStatus @default(PAUSED)

  consecutiveFailures        Int @default(0)
  consecutiveSuccesses       Int @default(0)
  consecutiveLatencyBreaches Int @default(0)

  monitoredServiceId String
  monitoredService   MonitoredService @relation(fields: [monitoredServiceId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  clients          Client[]
  incidents        Incident[]
  monitorEvents    MonitorEvent[]
  monitorCheckLogs MonitorCheckLog[]

  @@index([organizationId])
  @@index([monitoredServiceId])
}

model Incident {
  id          String           @id @default(uuid())
  title       String
  description String?
  status      IncidentStatus   @default(OPEN)
  type        IncidentType
  severity    IncidentSeverity

  monitorId String
  monitor   Monitor @relation(fields: [monitorId], references: [id])

  openedAt       DateTime  @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  monitorEvents MonitorEvent[]

  @@index([monitorId, status])
  @@index([type, status])
}

model MonitorEvent {
  id        String  @id @default(uuid())
  monitorId String
  monitor   Monitor @relation(fields: [monitorId], references: [id])

  eventType  MonitorEventType
  fromStatus MonitorStatus?
  toStatus   MonitorStatus?
  message    String?

  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id])

  createdAt DateTime @default(now())

  @@index([monitorId, createdAt])
}

model MonitorCheckLog {
  id        String  @id @default(uuid())
  monitorId String
  monitor   Monitor @relation(fields: [monitorId], references: [id])

  checkedAt     DateTime      @default(now())
  success       Boolean
  derivedStatus MonitorStatus

  latencyMs        Int?
  httpStatus       Int?
  sslDaysRemaining Int?
  errorMessage     String?

  createdAt DateTime @default(now())

  @@index([monitorId, checkedAt])
}

enum ClientType {
  client
  project
  department
}

enum ClientStatus {
  active
  inactive
  archived
}

enum UserStatus {
  active
  inactive
  suspended
}

enum OrganizationStatus {
  active
  inactive
}

enum TeamStatus {
  active
  inactive
}

enum OrganizationRole {
  owner
  manager
  member
}

enum TeamRole {
  manager
  responder
  viewer
}

enum MonitorType {
  HTTP
  SSL
  PING
}

enum MonitorStatus {
  UP
  DOWN
  DEGRADED
  PAUSED
  MAINTENANCE
}

enum IncidentStatus {
  OPEN
  ACKED
  RESOLVED
}

enum IncidentType {
  DOWN
  HIGH_LATENCY
  SSL_EXPIRING
  SSL_INVALID
}

enum IncidentSeverity {
  CRITICAL
  HIGH
  WARNING
  INFO
}

enum MonitorEventType {
  STATUS_CHANGE
  INCIDENT_OPENED
  INCIDENT_RESOLVED
}
